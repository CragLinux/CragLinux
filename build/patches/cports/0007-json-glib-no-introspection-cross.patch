main/json-glib: disable introspection when cross-compiling.

Same rationale as main/glib: gobject-introspection is !cross, so the
enabled introspection feature can never resolve in a cross build. Found
in the same armv7 self-build chain (json-glib is a rauc dependency).

diff --git a/main/json-glib/template.py b/main/json-glib/template.py
index b01a1f34..45886895 100644
--- a/main/json-glib/template.py
+++ b/main/json-glib/template.py
@@ -3,6 +3,10 @@ pkgver = "1.10.8"
 pkgrel = 0
 build_style = "meson"
 configure_args = ["-Dintrospection=enabled", "-Dinstalled_tests=false"]
+
+if self.profile().cross:
+    # gobject-introspection is !cross; same rationale as main/glib
+    configure_args += ["-Dintrospection=disabled"]
 hostmakedepends = [
     "gettext",
     "glib-devel",
