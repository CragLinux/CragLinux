# Crag U-Boot Kconfig fragment for rpi_arm64_defconfig (docs/04 §4).
#
# Same AD-009 deviation as the QEMU boards (MIGRATION-NOTES §12): env in
# a FAT file (uboot.env) on the bootenv partition — here mmc 0 part 2
# (the eMMC). mmc 0, NOT 1: the downstream CM5 DTB aliases
# mmc0 = &sdio1 and sdio1 is the eMMC (bcm2712-rpi-cm5.dtsi) — the
# reverse of rpi4's mainline-DTB numbering, where mmc 0 was the wifi
# SDIO bus answering every access with -110. If `mmc list` on metal
# ever disagrees, this and boot.script.in flip together.
# fw_env.config on the userspace side points libubootenv at the same
# file via the bootenv mount (rootfs.sh reads CONFIG_ENV_SIZE from
# this fragment).
CONFIG_ENV_IS_IN_FAT=y
# CONFIG_ENV_IS_NOWHERE is not set
CONFIG_ENV_FAT_INTERFACE="mmc"
CONFIG_ENV_FAT_DEVICE_AND_PART="0:2"
CONFIG_ENV_FAT_FILE="uboot.env"
CONFIG_ENV_SIZE=0x10000
CONFIG_FAT_WRITE=y
# Slot logic needs `part number` (PARTLABEL lookup) + script bootmeth
CONFIG_CMD_PART=y
CONFIG_BOOTMETH_SCRIPT=y
CONFIG_CMD_SAVEENV=y
# Host tools without OpenSSL (Fedora 44 drops the ENGINE headers U-Boot's
# signing tools include); boot.scr is compiled by the container's mkimage.
# CONFIG_TOOLS_LIBCRYPTO is not set
# CONFIG_TOOLS_FIT_SIGNATURE is not set
# CONFIG_TOOLS_KWBIMAGE is not set
