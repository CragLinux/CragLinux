# Board additions to the seeded U-Boot env (appended after the default
# env + boards/common/uboot/initial-env.in by the image stage).
#
# bootstd: go straight to the script bootmeth (our boot.scr). Without
# this, U-Boot 2026.07 walks the bootmeths in name order and burns
# seconds on efi_mgr ("EFI boot manager: Cannot load any image") and
# repeated bus probes before reaching the script — observed on the
# rpi4 first metal boot.
bootmeths=script
