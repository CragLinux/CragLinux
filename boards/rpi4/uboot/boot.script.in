# Crag U-Boot boot script — Raspberry Pi flavor (docs/04 §4, AD-009).
# Board override of boards/common/uboot/boot.script.in (the image stage
# prefers boards/<board>/uboot/boot.script.in when present): same
# BOOT_ORDER / BOOT_<slot>_LEFT slot logic, with two hardware changes:
#
#   * storage is mmc 1, not virtio — on rpi_arm64 U-Boot, mmc 0 is the
#     SDIO bus to the wifi chip and the SD slot (emmc2) is mmc 1 (a
#     first-metal-boot finding; mmc 0 gives voltage-select -110 errors)
#   * the DTB is the FIRMWARE-PROVIDED one at ${fdt_addr} — start4.elf
#     loaded it from the esp, applied overlays and mem/clock fixups, and
#     handed it to U-Boot (rpi_arm64_defconfig prior-stage convention).
#     The copies under boot.<slot>/dtbs/ are deliberately not loaded;
#     ${fdtcontroladdr} is the fallback if the firmware handoff is ever
#     absent.
#
# Substituted by the image stage:
#   @CMDLINE@    board+variant kernel cmdline (console=..., no root=)
#   @ROOTFLAGS@  "ro" (prod squashfs) or "rw" (dev ext4)
#   @KERNEL_IMG@ kernel file name in the boot partitions (Image)
#   @BOOTCMD@    booti (aarch64)

test -n "${BOOT_ORDER}" || setenv BOOT_ORDER "A B"
test -n "${BOOT_A_LEFT}" || setenv BOOT_A_LEFT 3
test -n "${BOOT_B_LEFT}" || setenv BOOT_B_LEFT 3

test -n "${fdt_addr}" || setenv fdt_addr ${fdtcontroladdr}

for BOOT_SLOT in ${BOOT_ORDER}; do
    if test "x${BOOT_SLOT}" = "xA"; then
        if test ${BOOT_A_LEFT} -gt 0; then
            setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1
            echo "Crag: trying slot A (${BOOT_A_LEFT} attempts left)"
            saveenv
            if part number mmc 1 boot.A crag_bootpart; then
                if fatload mmc 1:${crag_bootpart} ${kernel_addr_r} @KERNEL_IMG@; then
                    setenv bootargs "@CMDLINE@ root=PARTLABEL=rootfs.A @ROOTFLAGS@ rauc.slot=A"
                    @BOOTCMD@ ${kernel_addr_r} - ${fdt_addr}
                fi
            fi
            echo "Crag: slot A failed to boot"
        fi
    fi
    if test "x${BOOT_SLOT}" = "xB"; then
        if test ${BOOT_B_LEFT} -gt 0; then
            setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1
            echo "Crag: trying slot B (${BOOT_B_LEFT} attempts left)"
            saveenv
            if part number mmc 1 boot.B crag_bootpart; then
                if fatload mmc 1:${crag_bootpart} ${kernel_addr_r} @KERNEL_IMG@; then
                    setenv bootargs "@CMDLINE@ root=PARTLABEL=rootfs.B @ROOTFLAGS@ rauc.slot=B"
                    @BOOTCMD@ ${kernel_addr_r} - ${fdt_addr}
                fi
            fi
            echo "Crag: slot B failed to boot"
        fi
    fi
done

echo "Crag: no bootable slot (all attempts exhausted) - resetting"
reset
