# Crag U-Boot Kconfig fragment for qemu_arm64_defconfig (docs/04 §4).
#
# DEVIATION from AD-009 (recorded in MIGRATION-NOTES §12): the design
# wants a raw REDUNDANT env at fixed offsets in the bootenv partition,
# but U-Boot has no raw-block env backend for virtio storage (ENV_IS_IN_
# MMC/SPI/FLASH etc. only) — so the QEMU boards keep the env in a FAT
# file (uboot.env) on the bootenv partition, single copy. The BOOT_ORDER
# / BOOT_x_LEFT semantics are identical; fw_env.config on the userspace
# side points libubootenv at the same FAT file (M2 bundle work).
CONFIG_ENV_IS_IN_FAT=y
# CONFIG_ENV_IS_NOWHERE is not set
CONFIG_ENV_FAT_INTERFACE="virtio"
CONFIG_ENV_FAT_DEVICE_AND_PART="0:2"
CONFIG_ENV_FAT_FILE="uboot.env"
CONFIG_ENV_SIZE=0x10000
CONFIG_FAT_WRITE=y
# Slot logic needs `part number` (PARTLABEL lookup) + script bootmeth
CONFIG_CMD_PART=y
CONFIG_BOOTMETH_SCRIPT=y
CONFIG_CMD_SAVEENV=y
# Host tools without OpenSSL: Fedora 44's openssl-devel drops the ENGINE
# headers U-Boot's signing tools include (openssl/engine.h). FIT signing
# is not used here — boot.scr is compiled by the container's mkimage.
# CONFIG_TOOLS_LIBCRYPTO is not set
# CONFIG_TOOLS_FIT_SIGNATURE is not set
# CONFIG_TOOLS_KWBIMAGE is not set
