# Astro Linux - Fixed base system packages
# These define the opinionated base and are not customizable.
# Board-specific and variant-specific packages are additive.
musl
chimerautils
dinit
dinit-chimera
base-bootstrap
apk-tools
turnstile
nyagetty     # console getty (standalone util-linux agetty + dinit service), per Chimera base-full-core
dinit-chimera-udev  # udev-backed device manager glue (/usr/lib/dinit-devd) — early-devd fails 127 without it
util-linux-fdisk    # sfdisk: on-device GPT growth of the data partition (docs/02 §4, M1 "grown+mounted")
e2fsprogs           # e2fsck + resize2fs: fsck/grow the /data ext4 (same M1 item)
dbus                # system bus (rauc service + astrod at M3; docs/02 §5.1 graph)
rauc                # A/B updater (AD-010/AD-011; astro-cports template, docs/05)
iwd                 # wifi daemon (AD-015: manages wifi ONLY — EnableNetworkConfiguration=false
                    # via the common overlay's /etc/iwd/main.conf; dhcpcd owns addressing).
                    # Platform capability on every image: [api].wifi=false boards simply
                    # have no radios, the daemon idles (docs/07 §1).
iwd-dinit           # dinit service file (auto-split subpackage, like dhcpcd-dinit);
                    # SHADOWED by the common overlay's /etc/dinit.d/iwd (STATE_DIRECTORY
                    # + dbus-daemon dependency fix — upstream names the bus service 'dbus')
