# Crag Linux - network stack for the M3 phase-3 network group
# (docs/02 §6 shared-fragment convention; docs/07 §1 AD-015: iwd manages
# wifi ONLY, dhcpcd owns addressing, cragd is the policy brain).
#
# The wifi/crypto list is taken from iwd's OWN runtime capability check:
# iwd-3.12 src/main.c check_crypto() names exactly these CONFIG_* symbols
# when a kernel is missing them (verified against the pinned tarball, not
# the wiki). Everything =y — Crag kernels are monolithic (AD-006).

# cfg80211/mac80211: the wifi subsystem iwd drives over nl80211. RFKILL
# is cfg80211's soft-block interface (iwctl adapter ... property).
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y

# iwd userspace-crypto (AF_ALG) requirements — iwd does all EAPOL/PSK
# crypto in userspace via the kernel crypto API (no wpa_supplicant-style
# per-driver offload). Hard requirements (check_crypto returns -ENOTSUP
# without these):
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_ECB=y
# Soft requirements iwd warns about (SHA512: "certain TLS connections
# might fail"; CBC: WPS; MD4: EAP-MSCHAPv2, src/eap-mschapv2.c:572;
# KEY_DH_OPERATIONS: WPS Diffie-Hellman; KEYS + asymmetric-key chain:
# TLS-based WPA-Enterprise, kernel 4.20+). Cheap in a monolithic build
# and they keep the enterprise path open without a kernel respin.
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_MD4=y
CONFIG_KEYS=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y

# TUN/TAP: VPN-shaped workloads and test harnesses (docs/02 §6).
CONFIG_TUN=y

# Netfilter for the phase-4 AP captive portal (docs/07 §4) and general
# firewalling. nftables only (no legacy xtables) — dinit-chimera carries
# no iptables userspace. The exact ruleset these serve is
# usr/lib/crag/portal-redirect-up.sh in the common overlay:
#
#   table ip crag_portal {
#     chain prerouting {
#       type nat hook prerouting priority dstnat;
#       iifname "wlan0" tcp dport 80 redirect to :8080
#       iifname "wlan0" udp dport 53 redirect to :5354
#     }
#   }
#
# Symbol-by-symbol against that ruleset:
#   NETFILTER/NF_TABLES  the nft table/chain/rule machinery itself
#   NF_TABLES_IPV4       "table ip" family support (net/ipv4/netfilter/
#                        Kconfig:28). TRAP, found by auditing the built
#                        .config: this bool was never set, so kconfig
#                        SILENTLY dropped the old fragment's NFT_NAT=y
#                        (depends on NF_TABLES_IPV4 || NF_TABLES_IPV6,
#                        net/netfilter/Kconfig:565) — the "netfilter
#                        basics" this fragment claimed since phase 3
#                        were half missing.
#   NFT_NAT              "type nat" chain support (the nat expression)
#   NFT_REDIR            the "redirect" statement — the one this pair
#                        actually executes (depends on NF_CONNTRACK +
#                        NF_NAT, selects NF_NAT_REDIRECT — Kconfig:556)
#   NF_NAT               the NAT core nft_redir/nft_nat translate through
#   NF_CONNTRACK         redirect is DNAT, and all NAT rides conntrack
# (tcp/udp dport and iifname matches are core nf_tables payload/meta
# expressions — no extra symbols.)
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_NAT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REDIR=y
# Not needed by the portal pair; kept for product firewalls (masquerade
# is the next thing every gateway-shaped product asks for).
CONFIG_NFT_MASQ=y
