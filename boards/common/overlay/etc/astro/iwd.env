# dinit env-file for the iwd shadow service (format: dinit(8) FILES —
# NAME=VALUE lines, '#' comments).
#
# iwd resolves its state directory (known networks, e.g. <ssid>.psk)
# from $STATE_DIRECTORY (iwd-3.12 src/storage.c:200, the systemd
# StateDirectory= convention) before falling back to the compiled-in
# /var/lib/iwd. Astro keeps wifi profiles on the mutable data partition:
# astrod renders <ssid>.psk files here from the store's
# network.wifi.connection (docs/07 §2 — everything regenerable from
# astro.json), and iwd autoconnects from them.
STATE_DIRECTORY=/data/net/iwd
#
# Config search path (iwd-3.12 src/main.c:548-567: the FIRST main.conf
# found along the ':' list wins). /run/astro/iwd holds astrod's AP-window
# netconfig override (wifi.zig ap_netconf_path, rendered only while the
# provisioning AP is up so iwd's built-in DHCP serves the portal pool);
# with no override present the baked /etc/iwd/main.conf stays
# authoritative, so boot behavior is unchanged. /run is tmpfs — a crash
# mid-window can never make the override permanent.
CONFIGURATION_DIRECTORY=/run/astro/iwd:/etc/iwd
