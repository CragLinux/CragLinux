# Crag SHADOW of the packaged iwd service (/etc/dinit.d wins over
# /usr/lib/dinit.d in dinit's service-dir search order — same mechanism
# as the rauc and early-fs-local.target shadows). Diffs vs the iwd-dinit
# file (cports/main/iwd/files/iwd), re-diff on iwd template bumps:
#
#   env-file           NEW: sets STATE_DIRECTORY=/data/net/iwd so wifi
#                      profiles live on the data partition (iwd reads the
#                      systemd-convention env var, iwd-3.12 src/storage.c;
#                      dinit-service(5) env-file is dinit 0.22's supported
#                      per-service environment mechanism). The directory
#                      is created cragd-owned by tmpfiles.d/cragd.conf:
#                      cragd RENDERS <ssid>.psk profiles there from the
#                      store (docs/07 §2), root iwd reads them regardless.
#   depends-on dbus-daemon  upstream says 'dbus' but our dbus package
#                      installs the service as 'dbus-daemon' (the name
#                      cragd and the enable hook use) — the upstream
#                      dependency would fail to resolve on this image.
#   depends-on data-mount   hard: the state dir is on /data; starting
#                      without it would scribble profiles on the tmpfs.
#
# local.target is kept from upstream and (via early-tmpfiles) also
# guarantees /data/net/iwd exists before the daemon starts.
# AD-015: this daemon manages wifi ONLY (see /etc/iwd/main.conf);
# dhcpcd handles addressing on wlan0 like any other interface.

type = process
command = /usr/lib/iwd
env-file = /etc/crag/iwd.env
logfile = /var/log/iwd.log
before: network.target
depends-on: data-mount
depends-on: local.target
depends-on: pre-network.target
depends-on: dbus-daemon
