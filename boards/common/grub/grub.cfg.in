# Astro static grub.cfg (docs/04 §3, AD-008) — RAUC grub-backend slot
# selection: ORDER / <slot>_OK / <slot>_TRY in grubenv on the bootenv
# partition (partition 2, vfat). Deliberately static: no os-prober, no
# dynamic menus; identical across devices of a board.
#
# Generated at image time from boards/common/grub/grub.cfg.in with:
#   @CMDLINE@    board+variant kernel cmdline (console=..., no root=)
#   @ROOTFLAGS@  "ro" (prod squashfs) or "rw" (dev ext4)
#   @KERNEL_IMG@ kernel file name in the boot partitions (bzImage)
#
# Flow (RAUC's documented GRUB integration): pick the first slot in ORDER
# that is OK with no failed try; mark its TRY before booting; userspace
# rauc-mark-good clears TRY after a successful boot. A slot that dies
# before mark-good keeps TRY=1 and is skipped next boot -> fallback.
# Disk layout is fixed (AD-007): hd0,gpt2=bootenv, gpt3=boot.A, gpt5=boot.B.

serial --unit=0 --speed=115200
terminal_input serial console
terminal_output serial console

set envfile=(hd0,gpt2)/grubenv
load_env --file $envfile ORDER A_OK B_OK A_TRY B_TRY

# Robust defaults if the env block is missing/corrupt
if [ -z "$ORDER" ]; then
    set ORDER="A B"
    set A_OK=1
    set B_OK=1
    set A_TRY=0
    set B_TRY=0
fi

set default=0
set timeout=0

for SLOT in $ORDER; do
    if [ "$SLOT" = "A" ]; then
        set INDEX=0
        set OK=$A_OK
        set TRY=$A_TRY
        set A_TRY=1
    fi
    if [ "$SLOT" = "B" ]; then
        set INDEX=1
        set OK=$B_OK
        set TRY=$B_TRY
        set B_TRY=1
    fi
    if [ "$OK" -eq 1 -a "$TRY" -eq 0 ]; then
        set default=$INDEX
        break
    fi
done

save_env --file $envfile A_TRY B_TRY

menuentry "Astro slot A" {
    linux (hd0,gpt3)/@KERNEL_IMG@ @CMDLINE@ root=PARTLABEL=rootfs.A @ROOTFLAGS@ rauc.slot=A
}

menuentry "Astro slot B" {
    linux (hd0,gpt5)/@KERNEL_IMG@ @CMDLINE@ root=PARTLABEL=rootfs.B @ROOTFLAGS@ rauc.slot=B
}
